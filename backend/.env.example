# PostgreSQL connection string used by Prisma
# Matches the "postgres" service in docker-compose.yml at the repo root
# (run `docker compose up -d` there first). Point this elsewhere if you're
# using your own Postgres instance instead.
DATABASE_URL="postgresql://magic_auto:magic_auto@localhost:5433/magic_auto"

# Secret used to sign admin JWT sessions - change this in production
JWT_SECRET="super_secret_magic_auto_key_change_me_in_prod"

# Port the Express API listens on
PORT=4000

# Origin(s) allowed to call this API (the frontend dev/prod URL)
CORS_ORIGIN="http://localhost:5173"

NODE_ENV=development
